<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TORCH MC - Launchers</title>
    <link rel="icon" type="image/png" href="logo.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #0b0c10;
            color: #ffffff;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(34, 197, 94, 0.08) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(59, 130, 246, 0.08) 0%, transparent 40%),
                #0b0c10;
            padding: 20px;
            opacity: 0;
            animation: fadeIn 0.4s ease-in-out forwards;
        }

        @keyframes fadeIn {
            to {
                opacity: 1;
            }
        }

        /* هنا تم تكبير العرض (max-width: 750px) ليكون أكبر من الهوم بس بنفس الستايل */
        .container {
            max-width: 750px;
            width: 100%;
            background: rgba(18, 20, 31, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.06);
            padding: 40px 30px;
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.7);
            position: relative;
            overflow: hidden;
        }

        h1 {
            font-size: 32px;
            margin-bottom: 20px;
            text-align: center;
            background: linear-gradient(135deg, #ffffff 30%, #9ca3af 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 800;
            letter-spacing: 1px;
        }

        /* حقل البحث بنفس ستايل حقول الموقع */
        #searchInput {
            width: 100%;
            padding: 14px 20px;
            margin-bottom: 25px;
            background: rgba(26, 29, 45, 0.9);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            color: #fff;
            font-size: 15px;
            outline: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        #searchInput:focus {
            background: rgba(34, 197, 94, 0.08);
            border-color: rgba(34, 197, 94, 0.5);
            box-shadow: 0 0 20px rgba(34, 197, 94, 0.2);
        }

        #searchInput::placeholder {
            color: #6b7280;
        }

        /* قائمة اللانشرات (شبكة من عمودين أو حسب الرغبة) */
        #launchersList {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            max-height: 450px;
            overflow-y: auto;
            padding-right: 5px;
            margin-bottom: 25px;
        }

        #launchersList::-webkit-scrollbar {
            width: 6px;
        }
        #launchersList::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
        }

        /* كارت اللانشر بنفس ستايل أزرار الهوم */
        .launcher-card {
            background: rgba(26, 29, 45, 0.7);
            padding: 20px;
            border-radius: 14px;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid rgba(255, 255, 255, 0.04);
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 12px;
        }

        .launcher-card:hover {
            background: rgba(34, 197, 94, 0.15);
            border-color: rgba(34, 197, 94, 0.4);
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
        }

        .launcher-card img {
            width: 65px;
            height: 65px;
            border-radius: 12px;
            object-fit: cover;
            border: 2px solid rgba(34, 197, 94, 0.4);
            background: #12141f;
            box-shadow: 0 0 15px rgba(34, 197, 94, 0.15);
        }

        .launcher-info {
            width: 100%;
        }

        .launcher-info h3 {
            color: #ffffff;
            margin: 0 0 4px 0;
            font-size: 16px;
            font-weight: 700;
        }

        .launcher-info p {
            color: #9ca3af;
            margin: 0;
            font-size: 12px;
            line-height: 1.4;
        }

        /* زر الداونلود داخل الكارت */
        .download-btn {
            background: rgba(34, 197, 94, 0.15);
            color: #22c55e;
            padding: 10px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 13px;
            transition: all 0.3s ease;
            border